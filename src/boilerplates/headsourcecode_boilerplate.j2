# Models simple cone beam geometry
######################################################

## Include File ###############################
includeFile=ConvertedTopasFile.txt
{% if fan_mode == 'Full Fan' and bowtie_enabled %}{% if legacy_bowtie %}includeFile = fullfan.txt
{% else %}includeFile = bowtie_ff.txt
{% endif %}{% endif %}
{% if fan_mode == 'Half Fan' and bowtie_enabled %}{% if legacy_bowtie %}includeFile = halffan.txt
{% else %}includeFile = bowtie_hf.txt
{% endif %}{% endif %}
{% if simulation_type == 'DICOM' %}includeFile = patientDICOM.txt
{% endif %}
{% if simulation_type == 'CTDI' %}sv:Ph/Default/LayeredMassGeometryWorlds = {% if water_chamber_enabled %}10 "ChamberPlugCentre" "ChamberPlugTop" "ChamberPlugBottom" "ChamberPlugLeft" "ChamberPlugRight" "ChamberPlugCentre_water" "ChamberPlugTop_water" "ChamberPlugBottom_water" "ChamberPlugLeft_water" "ChamberPlugRight_water"{% else %}5 "ChamberPlugCentre" "ChamberPlugTop" "ChamberPlugBottom" "ChamberPlugLeft" "ChamberPlugRight"{% endif %}
{% endif %}
{% if simulation_type == 'ICRP145' %}{% if use_voxel_phantom %}includeFile = phantomVoxel.txt
{% else %}includeFile = phantomICRP145.txt
{% endif %}i:Ts/ParameterizationErrorMaxReports = 5
{% endif %}

## Some Control Parameters ####################
i:Ts/Seed = {{ seed }}
i:Ts/NumberOfThreads = {{ threads }}
s:Ts/G4DataDirectory = "{{ g4_data_directory }}"

## Define World Geometry ############################
d:Ge/World/HLX=1.2 m # HalfLength
d:Ge/World/HLY=1.2 m
d:Ge/World/HLZ=1.2 m




# Physics ############################################

# Use this only for placing geometry - prototyping
# sv:Ph/Default/Modules=1 "g4em-standard_opt0"

# default for when need to score
s:Ph/ListName="Default"
b:Ph/ListProcesses="False" # Set true to dump list of active physics processes to console
s:Ph/Default/Type="Geant4_Modular"
#EM-only physics sufficient for kV photon imaging (gamma, ~100 keV); hadronic/decay modules not needed
sv:Ph/Default/Modules=1 "g4em-standard_opt4"

# EM range from Brian HZapien Campos, 'Monte Carlo Modelling of the kV and MV Imaging Systems on the Varian Truebeam STx Linac'
d:Ph/Default/EMRangeMin=100. eV
# kV-only simulation; 1 MeV sufficient (max tube voltage 140 kV = 0.14 MeV).
# Campos thesis used 521 MeV for kV+MV modelling.
d:Ph/Default/EMRangeMax=1.0 MeV

# Group Component ###########################################

# Actively rotate imaging system
s:Ge/Rotation/Type="Group"
s:Ge/Rotation/Parent="World"
dc:Ge/Rotation/RotX= {{ patient_pitch }}
d:Ge/patrotation/yaw= {{ patient_yaw }}
dc:Ge/Rotation/RotY= 180. deg + Ge/patrotation/yaw
dc:Ge/Rotation/RotZ= Tf/Rotate/Value + {{ patient_roll_value }} deg # Time feature defined below
d:Ge/Rotation/TransX=0.0 mm
d:Ge/Rotation/TransY=0.0 mm
d:Ge/Rotation/TransZ=0.0 mm

# X-Y blades group
s:Ge/CollimatorsVertical/Type="Group"
s:Ge/CollimatorsVertical/Parent="Rotation"
d:Ge/CollimatorsVertical/RotX=90. deg
d:Ge/CollimatorsVertical/RotY=0. deg
d:Ge/CollimatorsVertical/RotZ=0. deg
d:Ge/CollimatorsVertical/TransY=11.7 cm + Ge/BeamPosition/TransY # 11.7 cm downstream of source

s:Ge/CollimatorsHorizontal/Type="Group"
s:Ge/CollimatorsHorizontal/Parent="CollimatorsVertical"
dc:Ge/CollimatorsHorizontal/RotX=0. deg
dc:Ge/CollimatorsHorizontal/RotY=0. deg
dc:Ge/CollimatorsHorizontal/RotZ=180. deg
d:Ge/CollimatorsHorizontal/TransZ=1.4 cm + Ge/Coll1/HLZ

###########################################################
# kV jaw blades: RECTANGULAR lead blocks (TsBox).
# TODO: adapt to trapezoid blades (true jaw shape) later.
#
# Convention: collN_trans_* is the FIELD-DEFINING APERTURE EDGE
# (cm, from fieldtobladeopening geometric demagnification: field x 11.7/100).
# The block centre is offset OUTWARD by its shaping half-length (HLY), so the
# inner face sits exactly at the aperture edge. Rectangles replace the old
# G4RTrap wedges, whose taper corners collided at small (demagnified)
# openings; the original per-blade rotations are kept (they orient the thin
# axis along the shaping direction). HLX/HLZ are housing coverage -- make
# them larger if off-axis leakage appears in the fluence-slab diagnostic.
###########################################################

# top collimator
s:Ge/Coll1/Type="TsBox"
s:Ge/Coll1/Parent="CollimatorsVertical"
s:Ge/Coll1/Material="Lead"
dc:Ge/Coll1/TransX=0 cm
dc:Ge/Coll1/TransY = {{ coll1_trans_y }} + Ge/Coll1/HLY
dc:Ge/Coll1/TransZ=0. cm
d:Ge/Coll1/HLX=7.5 cm
d:Ge/Coll1/HLY=3.0 cm
d:Ge/Coll1/HLZ=0.5 cm
s:Ge/Coll1/Color="red"

# bottom collimator
s:Ge/Coll2/Type="TsBox"
s:Ge/Coll2/Parent="CollimatorsVertical"
s:Ge/Coll2/Material="Lead"
dc:Ge/Coll2/TransX=0 cm
dc:Ge/Coll2/TransY = {{ coll2_trans_y }} - Ge/Coll2/HLY
dc:Ge/Coll2/TransZ=0. cm
d:Ge/Coll2/HLX=7.5 cm
d:Ge/Coll2/HLY=3.0 cm
d:Ge/Coll2/HLZ=0.5 cm
s:Ge/Coll2/Color="red"

# right collimator
s:Ge/Coll3/Type="TsBox"
s:Ge/Coll3/Parent="CollimatorsHorizontal"
s:Ge/Coll3/Material="Lead"
dc:Ge/Coll3/TransX = {{ coll3_trans_x }} + Ge/Coll3/HLX
dc:Ge/Coll3/TransY=0. cm
dc:Ge/Coll3/TransZ=0. cm
d:Ge/Coll3/HLX=3.0 cm
d:Ge/Coll3/HLY=7.5 cm
d:Ge/Coll3/HLZ=0.5 cm
s:Ge/Coll3/Color="red"

# left collimator
s:Ge/Coll4/Type="TsBox"
s:Ge/Coll4/Parent="CollimatorsHorizontal"
s:Ge/Coll4/Material="Lead"
dc:Ge/Coll4/TransX = {{ coll4_trans_x }} - Ge/Coll4/HLX
dc:Ge/Coll4/TransY=0. cm
dc:Ge/Coll4/TransZ=0. cm
d:Ge/Coll4/HLX=3.0 cm
d:Ge/Coll4/HLY=7.5 cm
d:Ge/Coll4/HLZ=0.5 cm
s:Ge/Coll4/Color="red"

###########################################################
# Steel backing plates: rectangles sharing the lead's shaping
# footprint, separated along the bank stack axis (TransZ=-0.75 cm,
# shared face at the lead rear). No chained relative params: the
# shaping centre repeats the lead's const+param expression.
###########################################################

# top collimator steel backing
s:Ge/Coll1steel/Type="TsBox"
s:Ge/Coll1steel/Parent="CollimatorsVertical"
s:Ge/Coll1steel/Material="Steel"
dc:Ge/Coll1steel/TransX=0 cm
dc:Ge/Coll1steel/TransY = {{ coll1_trans_y }} + Ge/Coll1/HLY
dc:Ge/Coll1steel/TransZ=-0.75 cm
d:Ge/Coll1steel/HLX=7.5 cm
d:Ge/Coll1steel/HLY=3.0 cm
d:Ge/Coll1steel/HLZ=0.25 cm
s:Ge/Coll1steel/Color="pink"

# bottom collimator steel backing
s:Ge/Coll2steel/Type="TsBox"
s:Ge/Coll2steel/Parent="CollimatorsVertical"
s:Ge/Coll2steel/Material="Steel"
dc:Ge/Coll2steel/TransX=0 cm
dc:Ge/Coll2steel/TransY = {{ coll2_trans_y }} - Ge/Coll2/HLY
dc:Ge/Coll2steel/TransZ=-0.75 cm
d:Ge/Coll2steel/HLX=7.5 cm
d:Ge/Coll2steel/HLY=3.0 cm
d:Ge/Coll2steel/HLZ=0.25 cm
s:Ge/Coll2steel/Color="pink"

# right collimator steel backing
s:Ge/Coll3steel/Type="TsBox"
s:Ge/Coll3steel/Parent="CollimatorsHorizontal"
s:Ge/Coll3steel/Material="Steel"
dc:Ge/Coll3steel/TransX = {{ coll3_trans_x }} + Ge/Coll3steel/HLX
dc:Ge/Coll3steel/TransY=0. cm
dc:Ge/Coll3steel/TransZ=-0.75 cm
d:Ge/Coll3steel/HLX=3.0 cm
d:Ge/Coll3steel/HLY=7.5 cm
d:Ge/Coll3steel/HLZ=0.25 cm
s:Ge/Coll3steel/Color="pink"

# left collimator steel backing
s:Ge/Coll4steel/Type="TsBox"
s:Ge/Coll4steel/Parent="CollimatorsHorizontal"
s:Ge/Coll4steel/Material="Steel"
dc:Ge/Coll4steel/TransX = {{ coll4_trans_x }} - Ge/Coll4steel/HLX
dc:Ge/Coll4steel/TransY=0. cm
dc:Ge/Coll4steel/TransZ=-0.75 cm
d:Ge/Coll4steel/HLX=3.0 cm
d:Ge/Coll4steel/HLY=7.5 cm
d:Ge/Coll4steel/HLZ=0.25 cm
s:Ge/Coll4steel/Color="pink"

#BeamHardeningFilter

# Beam Hardening Filter Group — Ti thickness from imaging.bhf_thickness_mm (Kawahara et al. Phys Med 2016; default 0.89 mm)
s:Ge/BeamHardeningFilterGroup/Type="Group"
s:Ge/BeamHardeningFilterGroup/Parent="CollimatorsHorizontal"
d:Ge/BeamHardeningFilterGroup/RotX=0. deg
d:Ge/BeamHardeningFilterGroup/RotY=0. deg
d:Ge/BeamHardeningFilterGroup/RotZ=0. deg
d:Ge/BeamHardeningFilterGroup/TransZ=1.59 cm #preventgeometryoverlapwithvertical

# Beam Hardening Filter
# Omitted when bhf_thickness_mm is 0 (Ti-out bracketing) or bhf_mode is
# "spekpy" (Ti folded into the SpekPy source spectrum instead). NB: TOPAS HLZ
# is a HALF-length, so the geometric box spans 2x bhf_thickness_mm along Z.
{% if bhf_thickness_mm and bhf_mode == 'geometric' %}
s:Ge/BeamHardeningFilter/Type="TsBox"
s:Ge/BeamHardeningFilter/Material="Titanium"
s:Ge/BeamHardeningFilter/Parent="BeamHardeningFilterGroup"
d:Ge/BeamHardeningFilter/HLX=0.1 m
d:Ge/BeamHardeningFilter/HLY=0.1 m
d:Ge/BeamHardeningFilter/HLZ={{ bhf_thickness_mm }} mm
d:Ge/BeamHardeningFilter/TransX=0. m
d:Ge/BeamHardeningFilter/TransY=0. m
d:Ge/BeamHardeningFilter/TransZ=0. m # to prevent overlap with top and bottom collimator
dc:Ge/BeamHardeningFilter/RotX=0. deg
dc:Ge/BeamHardeningFilter/RotY=0. deg
dc:Ge/BeamHardeningFilter/RotZ=0. deg
s:Ge/BeamHardeningFilter/Color="lightblue"
s:Ge/BeamHardeningFilter/DrawingStyle="WireFrame"
{% endif %}

###########################################################
# Primary collimator mask (tube-housing kill box)
###########################################################
# Fixed lead aperture at 20 cm SDD (Y=-78.0 cm, downstream of the bow-tie
# whose thin axis ends at Y=-78.9 cm; upstream of the PhspSurface at -75).
# Cuts the source-cone tails (sigma 26/27.5 deg) and bow-tie scatter that the
# real tube housing / primary collimator would stop: without it the fluence
# slab diagnostic measured 50%-of-peak kerma out to |Z|=88 cm at the patient
# plane (2026-08-18). Identical for every protocol -- the per-field shaping
# stays with the jaws, so between-protocol statistics remain comparable.
#
# Port: largest clinical fan + penumbra margin at 20 cm SDD
#   X: half-fan needs 24.7 x 20/100 = 4.94 cm -> port 5.0 cm
#   Z: 10.7 x 20/100 = 2.14 cm -> port 2.7 cm
# Walls: 1.5 cm Pb (>>10 HVLs at 140 kVp); outer extent +-14 cm bounds every
# ray that can reach the phantom (41.8 deg at 100 cm SAD = tan 43 deg).
# Exact-abut tiling, no chained relative parameters.
# top/bottom walls (block +-Z beyond the port)
s:Ge/PrimaryMaskTop/Type="TsBox"
s:Ge/PrimaryMaskTop/Parent="Rotation"
s:Ge/PrimaryMaskTop/Material="Lead"
d:Ge/PrimaryMaskTop/HLX=14.0 cm
d:Ge/PrimaryMaskTop/HLY=1.5 cm
d:Ge/PrimaryMaskTop/HLZ=11.3 cm
d:Ge/PrimaryMaskTop/TransX=0.0 cm
d:Ge/PrimaryMaskTop/TransY=-78.0 cm
d:Ge/PrimaryMaskTop/TransZ=14.0 cm

s:Ge/PrimaryMaskBottom/Type="TsBox"
s:Ge/PrimaryMaskBottom/Parent="Rotation"
s:Ge/PrimaryMaskBottom/Material="Lead"
d:Ge/PrimaryMaskBottom/HLX=14.0 cm
d:Ge/PrimaryMaskBottom/HLY=1.5 cm
d:Ge/PrimaryMaskBottom/HLZ=11.3 cm
d:Ge/PrimaryMaskBottom/TransX=0.0 cm
d:Ge/PrimaryMaskBottom/TransY=-78.0 cm
d:Ge/PrimaryMaskBottom/TransZ=-14.0 cm

# left/right walls (block +-X beyond the port; shortened in Z to abut, not
# overlap, the top/bottom walls)
s:Ge/PrimaryMaskLeft/Type="TsBox"
s:Ge/PrimaryMaskLeft/Parent="Rotation"
s:Ge/PrimaryMaskLeft/Material="Lead"
d:Ge/PrimaryMaskLeft/HLX=9.0 cm
d:Ge/PrimaryMaskLeft/HLY=1.5 cm
d:Ge/PrimaryMaskLeft/HLZ=2.7 cm
d:Ge/PrimaryMaskLeft/TransX=-14.0 cm
d:Ge/PrimaryMaskLeft/TransY=-78.0 cm
d:Ge/PrimaryMaskLeft/TransZ=0.0 cm

s:Ge/PrimaryMaskRight/Type="TsBox"
s:Ge/PrimaryMaskRight/Parent="Rotation"
s:Ge/PrimaryMaskRight/Material="Lead"
d:Ge/PrimaryMaskRight/HLX=9.0 cm
d:Ge/PrimaryMaskRight/HLY=1.5 cm
d:Ge/PrimaryMaskRight/HLZ=2.7 cm
d:Ge/PrimaryMaskRight/TransX=14.0 cm
d:Ge/PrimaryMaskRight/TransY=-78.0 cm
d:Ge/PrimaryMaskRight/TransZ=0.0 cm





###########################################################
# Define beam source - cone beam
###########################################################
# Define location of source in geometry ##################
s:Ge/BeamPosition/Parent="Rotation"
s:Ge/BeamPosition/Type = "Group"
d:Ge/BeamPosition/TransX=0. cm
d:Ge/BeamPosition/TransY=-1000. mm
d:Ge/BeamPosition/TransZ=0. m
d:Ge/BeamPosition/RotX = 90. deg
d:Ge/BeamPosition/RotY = 0. deg
d:Ge/BeamPosition/RotZ = 0. deg
# spectrum - need input from spekpy
s:So/beam/BeamEnergySpectrumType = "Continuous"
s:So/beam/Type = "Beam"
s:So/beam/Component = "BeamPosition"
s:So/beam/BeamParticle = "gamma"
#### useful for debugging 
#d:So/beam/BeamEnergy=50 MeV
#s:So/beam/BeamParticle = "proton"
#d:So/beam/BeamEnergy=500 MeV
#s:So/beam/BeamParticle = "gamma"
#### End debugging 
s:So/beam/BeamPositionDistribution = "Gaussian"
s:So/beam/BeamPositionCutoffShape = "Rectangle"
d:So/beam/BeamPositionCutoffX = 50. mm
d:So/beam/BeamPositionCutoffY = 50. mm
# Focal spot: sigma = 0.4246 mm ~ FWHM/2.355 for 1.0 mm large focal spot (Campos thesis)
d:So/beam/BeamPositionSpreadX = 0.4246 mm
d:So/beam/BeamPositionSpreadY = 0.4246 mm
s:So/beam/BeamAngularDistribution = "Gaussian"
d:So/beam/BeamAngularCutoffX = 90. deg
d:So/beam/BeamAngularCutoffY = 90. deg
# Angular spread: sigma_X = 26.1 deg, sigma_Y = 27.5 deg (Campos thesis, Table 3.3)
d:So/beam/BeamAngularSpreadX = 26.1 deg
d:So/beam/BeamAngularSpreadY = 27.5 deg

i:So/beam/NumberOfHistoriesInRun = {{ histories }}

# Time Feature ####################################

# full fan rotation rate
i:Tf/NumberOfSequentialTimes = {{ sequential_times }}
i:Tf/Verbosity = 0
d:Tf/TimelineEnd = {{ timeline_end }}
# Simulation sampling rate, not clinical rotation speed (clinical: 1.5-6.0 deg/s per Mao et al. 2018)
{% if rotation_direction == 'kV-kV' %}
s:Tf/Rotate/Function = "Step"
dv:Tf/Rotate/Times = 2 1 2 s
dv:Tf/Rotate/Values = 2 {{ start_angle_value }} {{ second_angle_value }} deg
{% else %}
s:Tf/Rotate/Function = "Linear deg"
d:Tf/Rotate/Rate = {{ rotation_rate }}
d:Tf/Rotate/StartValue = {{ start_angle }}
{% endif %}
i:Ts/ShowHistoryCountAtInterval = 100000


{% if graphics_enabled %}Ts/UseQt="True"
s:Gr/ViewA/Type="OpenGL"
b:Gr/Enable="True"
{% endif %}
i:Gr/ViewA/WindowSizeX=1024
i:Gr/ViewA/WindowSizeY=768
d:Gr/ViewA/Theta=70.0 deg
d:Gr/ViewA/Phi=10.0 deg
b:Gr/ViewA/IncludeAxes="True"
d:Gr/ViewA/AxesSize=0.5 m
b:Ts/ShowCPUTime="True"
sv:Gr/ViewA/VisibleWorlds = 1 "All"
